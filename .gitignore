# Binaries
bin/
tmp/

**/*/dist
# Note: web/dist is generated by "make build-web" and must exist before "go build"
# because it is embedded into the binary via go:embed in webfs.go.

# Logs
logs/

# Environment
.env

# Go
vendor/
*.test
*.out

# Typespec
**/*/node_modules

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# SQLC generated (commit these — they are the source of truth for the DB layer)
# internal/db/repository/  ← do NOT ignore this

# API docs — generated by "make docs", never edit by hand
openapi.yaml
docs/node_modules/
docs/tsp-output/
